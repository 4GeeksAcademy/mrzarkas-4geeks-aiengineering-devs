# Plantilla para desarrollo local con datos sintéticos.
# Copiar a .env y completar los valores vacíos. No guardar secretos en Git.
# Este archivo no activa ni configura un entorno de producción.

# PostgreSQL (Compose): elegir nombre/usuario y generar contraseña local.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Usar los valores anteriores; hostname db para el Compose de la raíz.
# DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@db:5432/BASE
# Para ejecutar el backend en el host, usar el host/puerto PostgreSQL accesible.
# Codificar caracteres especiales de usuario/contraseña en la URL.
DATABASE_URL=

# URLs y puertos del stack local.
BACKEND_URL=http://backend:8000
BACKOFFICE_URL=http://localhost:8080
API_PORT=8000
FRONTEND_PORT=3000
BACKOFFICE_PORT=8080

# API. APP_NAME y opciones JWT adicionales usan estos mismos defaults en código.
APP_NAME="HealthCore API"
APP_ENVIRONMENT=development
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# Generar una clave independiente: openssl rand -hex 32
JWT_SECRET_KEY=

# Telemetría compartida: un frontend y un backend para clínicas US y UK.
# Sólo servidor: ninguna clave HMAC debe publicarse en el frontend.
# TELEMETRY_ENABLED=true sólo después de completar las claves.
# Compose inyecta estas variables sólo al backend; no se exponen al navegador.
# Settings lee .env desde el directorio de trabajo cuando se ejecuta localmente.
TELEMETRY_ENABLED=false
# URL visible desde el navegador (no usar hostname interno backend).
# Cambiarla si se cambia API_PORT. No contiene credenciales ni secretos.
BACKOFFICE_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Vacío = backend compartido. US/UK sólo conserva compatibilidad con el modo antiguo.
TELEMETRY_PROCESSING_REGION=
TELEMETRY_KEY_VERSION=v1
TELEMETRY_CONTEXT_TTL_SECONDS=300

# Eventos generales sin clínica: jurisdiction=null, claves propias.
# Endpoint opcional de referencia; no activa reenvío externo.
TELEMETRY_ENDPOINT=
TELEMETRY_USER_KEY=
TELEMETRY_SUBJECT_KEY=
TELEMETRY_CLINIC_KEY=
TELEMETRY_CONTEXT_KEY=
# Sólo para el antiguo modo de región fija; no se usa en backend compartido.
TELEMETRY_RESOURCE_KEY=

# Clínica US validada en servidor: claves y referencia exclusivamente US.
TELEMETRY_US_USER_KEY=
TELEMETRY_US_SUBJECT_KEY=
TELEMETRY_US_CLINIC_KEY=
TELEMETRY_US_CONTEXT_KEY=
TELEMETRY_US_RESOURCE_KEY=
TELEMETRY_US_ENDPOINT=

# Clínica UK validada en servidor: claves y referencia exclusivamente UK.
TELEMETRY_UK_USER_KEY=
TELEMETRY_UK_SUBJECT_KEY=
TELEMETRY_UK_CLINIC_KEY=
TELEMETRY_UK_CONTEXT_KEY=
TELEMETRY_UK_RESOURCE_KEY=
TELEMETRY_UK_ENDPOINT=

# Generar CADA clave por separado: openssl rand -hex 32
# Mínimo 32 bytes; las 14 claves activas deben ser distintas entre sí y de JWT.
# USER/SUBJECT/CLINIC/CONTEXT generales + cinco US + cinco UK.
# RESOURCE regional es necesaria para los eventos de incidencias del servidor.
# Usar valores independientes por entorno y mantenerlos estables: la rotación
# cambia seudónimos e invalida contextos. Los endpoints son opcionales y requieren
# URL absoluta con ruta /telemetry/events, sin credenciales/query/fragment.
# El stub no persiste ni realiza forwarding, aunque se configure una referencia.
# Lotes 20/10 segundos están definidos en código, no mediante variables ENV.
