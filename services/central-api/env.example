# Copy to services/central-api/.env. Compose reads this file both as the
# service env_file and as its interpolation source via --env-file.
API_PORT=8000
BACKOFFICE_PORT=8080
APP_ENVIRONMENT=development

# Local Docker Compose defaults.
# Compose service-to-service URL; use localhost only for commands run on host.
DATABASE_URL=postgresql+asyncpg://healthcore:healthcore_dev_password@postgres:5432/healthcore
POSTGRES_DB=healthcore
POSTGRES_USER=healthcore
POSTGRES_PASSWORD=healthcore_dev_password
POSTGRES_PORT=5432
JWT_SECRET_KEY=insecure-development-secret-change-me

# Use the asyncpg SQLAlchemy dialect for the API and Alembic.
