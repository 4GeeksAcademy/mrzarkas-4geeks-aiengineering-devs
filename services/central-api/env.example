# Copy to the repository root as .env for local Docker Compose overrides.
API_PORT=8000
APP_ENVIRONMENT=development

# Local Docker Compose defaults.
# DATABASE_URL=postgresql+asyncpg://healthcore:healthcore_dev_password@localhost:5432/healthcore
POSTGRES_DB=healthcore
POSTGRES_USER=healthcore
POSTGRES_PASSWORD=healthcore_dev_password
POSTGRES_PORT=5432

# Use the asyncpg SQLAlchemy dialect for the API and Alembic.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
