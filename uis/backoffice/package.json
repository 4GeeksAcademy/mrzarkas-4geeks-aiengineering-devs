{
  "name": "healthcore-backoffice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types:generate": "openapi-typescript contracts/openapi.json -o src/lib/api/generated.ts",
    "types:check": "node scripts/check-contracts.mjs",
    "assets:sync": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
