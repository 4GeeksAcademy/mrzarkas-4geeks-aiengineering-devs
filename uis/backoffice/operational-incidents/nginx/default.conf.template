# Local synthetic stack: generated by the official Nginx envsubst entrypoint.
# Only public values are available in this container; no HMAC/JWT secrets.
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location = /telemetry/config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"enabled":${TELEMETRY_ENABLED},"endpoint":"${BACKOFFICE_TELEMETRY_ENDPOINT}","environment":"${APP_ENVIRONMENT}"}';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
